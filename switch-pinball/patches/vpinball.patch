+////ps_segment
+
+// OpenGL port of the segmented display in bgfx/fs_display.sc.
+in vec2 tex0;
+uniform vec4 alphaSegState[4];
+uniform vec4 staticColor_Alpha;
+uniform vec4 glassTint_Roughness;
+uniform vec4 w_h_height;
+uniform sampler2D displayTex;
+uniform sampler2D displayGlass;
+
+void main()
+{
+   FS_LAYER_TO_GLOBAL;
+   const vec2 scale = vec2(1.0 + glassPadLeft + glassPadRight, 1.0 + glassPadTop + glassPadBottom);
+   const vec2 displayUv = tex0 * scale - vec2(glassPadLeft, glassPadTop);
+   const bool hasGlass = w_h_height.w != 0.0;
+   const vec4 glass = hasGlass ? texture(displayGlass, glassArea.xy + tex0 * glassArea.zw) : vec4(1.0, 1.0, 1.0, 0.0);
+   const float roughness = mix(glassTint_Roughness.w, 1.0, glass.a);
+   vec4 lit = vec4(0.0), unlit = vec4(0.0);
+   for (int i = 0; i < 4; ++i)
+   {
+      // Each RGBA tile stores distance fields for four of the 16 segments.
+      const vec4 sdf = texture(displayTex, vec2(0.25 * (displayUv.x + float(i)), displayUv.y));
+      const vec4 sharp = smoothstep(vec4(0.475), vec4(0.525), sdf);
+      const vec4 light = mix(sharp, vColor_Intensity.w * sdf * sdf, roughness);
+      unlit = max(light, unlit);
+      lit = max(light * alphaSegState[i], lit);
+   }
+   const float litLevel = max(max(lit.x, lit.y), max(lit.z, lit.w));
+   const float unlitLevel = max(max(unlit.x, unlit.y), max(unlit.z, unlit.w));
+   vec3 luminance = unlitLevel * staticColor_Alpha.rgb + litLevel * vColor_Intensity.rgb;
+   luminance = mix(luminance, w_h_height.rgb, 0.5 * glass.a) * glassTint_Roughness.rgb * glass.rgb;
+   if (staticColor_Alpha.w > 0.0)
+   {
+      float l = min(dot(luminance, vec3(0.176204, 0.812985, 0.0108109)), 1000.0);
+      luminance *= (l * 0.25 + 1.0) / (l + 1.0);
+   }
+   if (staticColor_Alpha.w > 1.0)
+      luminance = FBGamma(luminance);
+   color = vec4(luminance, 1.0);
+}
